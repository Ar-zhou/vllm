         # ==== XDS patch end: dspark SWA prefill inflight limit ====
+
+        # The EMS dSpark connector saves newly produced SWA pages after each
+        # prefill step. A step larger than the draft window recycles its oldest
+        # pages before EMS can read them, leaving holes in the remote prefix.
+        # Keep the configured MNB as the batch budget; only cap one request's
+        # producer chunk and its in-flight tokens to the draft window.
+        transfer = getattr(self.vllm_config, "kv_transfer_config", None)
+        spec = getattr(self.vllm_config, "speculative_config", None)
+        draft = getattr(spec, "draft_model_config", None)
+        draft_hf = getattr(draft, "hf_config", None)
+        draft_window = getattr(draft_hf, "sliding_window", None)
+        if draft_window is None:
+            layer_config = getattr(draft_hf, "transformer_layer_config", None)
+            draft_window = (layer_config.get("sliding_window")
+                            if isinstance(layer_config, dict)
+                            else getattr(layer_config, "sliding_window", None))
+        is_dspark_ems_producer = (
+            getattr(transfer, "kv_role", None) == "kv_producer"
+            and getattr(transfer, "kv_connector", None) == "MultiConnector"
+            and getattr(spec, "method", None) == "dspark"
+        )
+        logger.info(
+            "EMS dSpark scheduler gate: role=%s connector=%s method=%s "
+            "draft_window=%s enabled=%s",
+            getattr(transfer, "kv_role", None),
+            getattr(transfer, "kv_connector", None),
+            getattr(spec, "method", None), draft_window,
+            is_dspark_ems_producer)
+        if is_dspark_ems_producer and draft_window is None:
+            raise ValueError("EMS dSpark producer has no draft SWA window")
+        self.dspark_ems_swa_chunk_limit = (
+            draft_window if is_dspark_ems_producer else None)
+        if self.dspark_ems_swa_chunk_limit is not None:
+            limit = self.dspark_ems_swa_chunk_limit
+            if limit <= 0 or limit % self.cache_config.block_size:
+                raise ValueError("EMS dSpark SWA window must align to a KV block")
+            self.swa_prefill_inflight_limit = min(
+                self.swa_prefill_inflight_limit or limit, limit)
+            logger.info(
+                "EMS dSpark draft SWA: per-request prefill and in-flight "
